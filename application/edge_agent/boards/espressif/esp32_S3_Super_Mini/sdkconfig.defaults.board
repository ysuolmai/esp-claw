# ESP32-S3 SuperMini / ESP32-S3FH4R2
# Reference: ysuolmai/xiaozhi-esp32s3-supermini.
# 4 MB in-package Quad SPI flash + 2 MB in-package Quad SPI PSRAM.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4MB.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# 2 MB Quad PSRAM is too small and the wrong mode for S3 XIP-from-PSRAM.
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_RODATA=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n
CONFIG_MDNS_TASK_CREATE_FROM_INTERNAL=y
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=n

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

CONFIG_APP_WIFI_FORCE_PROVISION_GPIO=0
CONFIG_APP_WIFI_FORCE_PROVISION_HOLD_MS=5000
CONFIG_APP_STATUS_LED_WS2812_GPIO=48
CONFIG_APP_STATUS_LED_AP_BLINK_MS=800
CONFIG_APP_VOICE_PTT_GPIO=0
CONFIG_APP_VOICE_PTT_ACTIVE_LEVEL=0
CONFIG_APP_VOICE_PTT_MAX_RECORD_MS=60000
CONFIG_APP_VOICE_PTT_MIN_RECORD_MS=300
CONFIG_APP_VOICE_PTT_PLAYBACK_TIMEOUT_MS=20000

CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=7168
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=1536

# Keep networking lean for the 512 KB internal SRAM / 2 MB PSRAM target.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2048
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 4 MB flash profile: keep Web/local configuration, Lua, files, skills, and
# system tools; omit large optional integrations and media/display stacks.
CONFIG_APP_CLAW_ENABLE_EMOTE=n
CONFIG_APP_CLAW_MEMORY_MODE_FULL=n
CONFIG_APP_CLAW_MEMORY_MODE_LIGHTWEIGHT=y
CONFIG_BT_ENABLED=n

CONFIG_APP_CLAW_CAP_AGENT_MGR=n
CONFIG_APP_CLAW_CAP_IM_QQ=n
CONFIG_APP_CLAW_CAP_IM_FEISHU=n
CONFIG_APP_CLAW_CAP_IM_TG=y
CONFIG_APP_CLAW_CAP_IM_WECHAT=n
CONFIG_APP_CLAW_CAP_MCP_CLIENT=y
CONFIG_APP_CLAW_CAP_MCP_SERVER=y
CONFIG_APP_CLAW_CAP_SCHEDULER=y
CONFIG_APP_CLAW_CAP_LLM_INSPECT=y
CONFIG_APP_CLAW_CAP_WEB_SEARCH=y

CONFIG_APP_CLAW_LUA_DRIVER_ADC=y
CONFIG_APP_CLAW_LUA_DRIVER_GPIO=y
CONFIG_APP_CLAW_LUA_DRIVER_I2C=y
CONFIG_APP_CLAW_LUA_DRIVER_MCPWM=y
CONFIG_APP_CLAW_LUA_DRIVER_PCNT=y
CONFIG_APP_CLAW_LUA_DRIVER_TOUCH=y
CONFIG_APP_CLAW_LUA_DRIVER_UART=y

CONFIG_APP_CLAW_LUA_MODULE_AUDIO=y
CONFIG_APP_CLAW_LUA_MODULE_BLE=n
CONFIG_APP_CLAW_LUA_MODULE_BLE_HID=n
CONFIG_APP_CLAW_LUA_MODULE_BUTTON=y
CONFIG_APP_CLAW_LUA_MODULE_CAMERA=n
CONFIG_APP_CLAW_LUA_MODULE_DISPLAY=n
CONFIG_APP_CLAW_LUA_MODULE_ENVIRONMENTAL_SENSOR=y
CONFIG_APP_CLAW_LUA_MODULE_FUEL_GAUGE=y
CONFIG_APP_CLAW_LUA_MODULE_HTTP_SERVER=n
CONFIG_APP_CLAW_LUA_MODULE_IMAGE=n
CONFIG_APP_CLAW_LUA_MODULE_IMU=y
CONFIG_APP_CLAW_LUA_MODULE_IR=y
CONFIG_APP_CLAW_LUA_MODULE_KNOB=y
CONFIG_APP_CLAW_LUA_MODULE_LCD=n
CONFIG_APP_CLAW_LUA_MODULE_LCD_TOUCH=n
CONFIG_APP_CLAW_LUA_MODULE_LED_STRIP=y
CONFIG_APP_CLAW_LUA_MODULE_LVGL=n
CONFIG_APP_CLAW_LUA_MODULE_MAGNETOMETER=y
CONFIG_APP_CLAW_LUA_MODULE_SCI=n
CONFIG_APP_CLAW_LUA_MODULE_VISION=n

CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
CONFIG_CODEC_DUMMY_SUPPORT=y
CONFIG_CODEC_DATA_ADC_SUPPORT=y

CONFIG_AUDIO_DECODER_AAC_SUPPORT=n
CONFIG_AUDIO_DECODER_MP3_SUPPORT=n
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=n
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=y
CONFIG_AUDIO_ENCODER_OPUS_SUPPORT=y
