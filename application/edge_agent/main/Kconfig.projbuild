menu "App Config"

menu "Default Wi-Fi Settings"

    config APP_WIFI_SSID
        string "Default Wi-Fi SSID"
        default ""
        help
            Default Wi-Fi SSID used to populate app settings.

    config APP_WIFI_PASSWORD
        string "Default Wi-Fi password"
        default ""
        help
            Default Wi-Fi password used to populate app settings.

    config APP_WIFI_AP_SSID_PREFIX
        string "Provisioning AP SSID prefix"
        default "esp-claw"
        help
            Prefix used to build the unique provisioning AP SSID. The full
            SSID is "<prefix>-<MAC[3..5]>" (e.g. esp-claw-84AEE5).

    config APP_WIFI_AP_CHANNEL
        int "Provisioning AP channel"
        range 1 13
        default 1
        help
            Channel used by the provisioning SoftAP.

    config APP_WIFI_AP_MAX_CONN
        int "Provisioning AP max connections"
        range 1 10
        default 4
        help
            Maximum number of concurrent stations on the provisioning AP.

    config APP_WIFI_MAX_RETRY
        int "STA max retries before AP fallback"
        range 1 20
        default 5
        help
            After this many consecutive STA connection failures the device
            falls back to pure AP mode and waits for the user to provision
            new credentials.

    config APP_WIFI_FORCE_PROVISION_GPIO
        int "GPIO used for BOOT long-press Wi-Fi provisioning"
        range -1 49
        default -1
        help
            GPIO sampled as an active-low BOOT/config button. Set to -1 to
            disable. Board profiles such as ESP32-S3 SuperMini can set this
            to GPIO0.

    config APP_WIFI_FORCE_PROVISION_HOLD_MS
        int "BOOT hold time for Wi-Fi provisioning"
        range 500 30000
        default 5000
        help
            Holding the configured BOOT GPIO low for this many milliseconds
            requests a one-shot provisioning boot. Saved Wi-Fi credentials
            are kept; the next boot simply skips STA and opens the AP portal.

endmenu

menu "Status LED"

    config APP_STATUS_LED_WS2812_GPIO
        int "WS2812 status LED GPIO"
        range -1 49
        default -1
        help
            GPIO for a single WS2812 status LED. Set to -1 to disable. The
            firmware keeps the LED off during normal operation and blinks it
            slowly only while the provisioning AP is open.

    config APP_STATUS_LED_AP_BLINK_MS
        int "Provisioning AP LED blink interval"
        range 100 5000
        default 800
        help
            Blink interval for the status LED when the provisioning AP is
            active and STA Wi-Fi is not connected.

endmenu

menu "Default Web Admin Security"

    config APP_ADMIN_USERNAME
        string "Default Web Admin username"
        default "admin"
        help
            Build-time fallback username for STA Web Admin HTTP Basic Auth.
            NVS config takes precedence.

    config APP_ADMIN_PASSWORD
        string "Default Web Admin password"
        default ""
        help
            Optional build-time fallback password for STA Web Admin HTTP
            Basic Auth. If unset and no NVS password exists, the firmware
            generates a password from the provisioning AP suffix and prints it
            to the serial log.

endmenu

menu "Default Voice Settings"

    config APP_VOICE_SERVER_URL
        string "Default voice WebSocket server URL"
        default ""
        help
            Optional default LAN voice server URL used by documentation and
            Web Admin config. The SuperMini Lua voice-stream script also
            accepts a per-run uri argument.

    config APP_VOICE_PTT_GPIO
        int "GPIO used for push-to-talk voice streaming"
        range -1 49
        default -1
        help
            GPIO sampled as a push-to-talk input. Set to -1 to disable. The
            ESP32-S3 SuperMini profile maps this to BOOT/GPIO0.

    config APP_VOICE_PTT_ACTIVE_LEVEL
        int "Push-to-talk active level"
        range 0 1
        default 0
        help
            Logic level treated as pressed for the push-to-talk GPIO.

    config APP_VOICE_PTT_MAX_RECORD_MS
        int "Push-to-talk maximum record time"
        range 1000 120000
        default 60000
        help
            Safety cap for one push-to-talk utterance. Releasing the button
            ends recording earlier.

    config APP_VOICE_PTT_MIN_RECORD_MS
        int "Push-to-talk minimum record time"
        range 0 5000
        default 300
        help
            Minimum capture time before a button release is allowed to stop
            the current utterance. This avoids empty streams from short taps.

    config APP_VOICE_PTT_PLAYBACK_TIMEOUT_MS
        int "Push-to-talk playback wait timeout"
        range 0 60000
        default 20000
        help
            Maximum time to keep the voice WebSocket open waiting for server
            reply audio after recording stops.

endmenu

menu "Default Search Settings"

    config APP_SEARCH_HTTP_ALLOWLIST
        string "Default HTTP Request allowlist"
        default "*"
        help
            Default value used to populate app setting `search_http_allowlist`.
            Use `*` to allow all hosts, or a comma-separated list of domains/IPs.

            e.g. "api.example.com,*.example.org,203.0.113.10"

endmenu

endmenu
